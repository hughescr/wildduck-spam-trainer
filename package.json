{
  "name": "wildduck-spam-trainer",
  "version": "0.1.1",
  "description": "AWS Lambda that trains the Rspamd Bayes classifier from WildDuck marked.spam / marked.ham webhooks",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Craig Hughes",
  "repository": {
    "type": "git",
    "url": "https://github.com/hughescr/wildduck-spam-trainer.git"
  },
  "engines": {
    "node": ">=26 <27",
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxlint": "^1.89.0",
    "serverless": "^4.45.0"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "smoke": "node scripts/smoke.mjs",
    "validate": "bun check --no-script && bun run lint && bun test && bun run build && bun run smoke",
    "package": "serverless package --stage prod",
    "deploy": "bash scripts/deploy.sh",
    "postversion": "bash scripts/postversion.sh",
    "gitflow:init": "bash scripts/init-gitflow.sh",
    "test:release": "bash scripts/test-release.sh"
  },
  "trustedDependencies": [
    "serverless"
  ]
}
